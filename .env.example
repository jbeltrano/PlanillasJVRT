POSTGRES_USER=mi_usuario
POSTGRES_PASSWORD=mi_clave_segura
POSTGRES_DB=mi_base_datos
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria
DJANGO_DEBUG=0
# *.trycloudflare.com permite usar el túnel rápido sin editar nada cada vez
# que cambia la URL aleatoria.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Administrador inicial (se crea al arrancar si aún no existe).
# DJANGO_ADMIN_PASSWORD es obligatoria: sin ella el arranque falla.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=cambia_esta_clave_por_una_segura

# Puerto del contenedor web en el host
WEB_PORT=8000

# Túnel con nombre de Cloudflare (opcional, requiere dominio propio).
# Se obtiene en Zero Trust > Networks > Tunnels.
# CLOUDFLARE_TUNNEL_TOKEN=
